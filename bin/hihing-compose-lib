#!/usr/bin/env bash
set -euo pipefail

# Shared helpers for `docker-compose-*` wrappers.
# Copy this file into the same directory as the wrapper scripts
# (for example `/usr/local/bin`) so `source "${SCRIPT_DIR}/hihing-compose-lib"`
# keeps working after deployment.

detect_compose_root() {
  local dir="${PWD}"

  while [ -n "${dir}" ] && [ "${dir}" != "/" ]; do
    if [ -f "${dir}/docker-compose.yml" ]; then
      printf '%s\n' "${dir}"
      return 0
    fi
    dir="$(dirname "${dir}")"
  done

  echo "docker-compose.yml 이 있는 폴더(또는 그 하위)에서 실행하세요." >&2
  return 1
}

COMPOSE_ROOT="$(detect_compose_root)"
BASE_COMPOSE="${COMPOSE_ROOT}/docker-compose.yml"
DEV_COMPOSE="${COMPOSE_ROOT}/docker-compose.dev.yml"
PROD_COMPOSE="${COMPOSE_ROOT}/docker-compose.prod.yml"

usage_compose_mode() {
  cat <<'EOF' >&2
usage: docker-compose-up [dev|prod] [--log-level LEVEL] [--rebuild] [--no-rolling] [platform|i-bff|o-bff|<compose-service> ...]

  서비스 미지정 시 docker-compose.yml + docker-compose.{dev|prod}.yml 병합 결과의 전체 서비스 대상
  축약어는 platform / i-bff / o-bff 만 인식 (그 외는 compose 서비스명 그대로)

  기본 up 플래그: -d --force-recreate --remove-orphans
  --rebuild           이미지 리빌드 추가 (--build). Dockerfile/의존성 변경 시에만 사용
                      코드만 바뀐 prod 재기동은 recreate 만으로 충분(컨테이너 기동 시 build+start)

  롤링: `<base>-1` `<base>-2` 가 함께 지정되면(platform / i-bff / o-bff 축약어 포함)
        한 대씩 재생성하고 healthy 확인 후 다음 대로 넘어간다.
        첫 대가 살아나지 못하면 두 번째는 건드리지 않고 중단한다.
  --no-rolling        롤링을 끄고 두 대를 동시에 재생성 (순단 발생, 긴급 복구용)
  HIHING_ROLLING_TIMEOUT  인스턴스당 준비 대기 한계(초, 기본 300). prod 는 기동 시 빌드가 돈다

  --log-level LEVEL   LOG_LEVEL 환경변수 주입 (미지정 시 셸의 LOG_LEVEL 사용)
                      예: warn / fatal,error,warn / log,debug
  env_file            .env (+ profile=hs 시 .env.hs 오버레이)
  HIHING_DEPLOY_PROFILE  hs | prod — 서버별 도메인(-hs) 구분 (기본: compose 루트의 .hihing-deploy-profile)
EOF
}

resolve_deploy_profile() {
  local raw=""

  if [ -n "${HIHING_DEPLOY_PROFILE:-}" ]; then
    raw="${HIHING_DEPLOY_PROFILE}"
  elif [ -f "${COMPOSE_ROOT}/.hihing-deploy-profile" ]; then
    raw="$(tr -d '[:space:]' < "${COMPOSE_ROOT}/.hihing-deploy-profile")"
  else
    raw="prod"
  fi

  case "${raw}" in
    hs|staging|stage|development|dev) printf '%s\n' hs ;;
    prod|production|live|operational) printf '%s\n' prod ;;
    *) printf '%s\n' prod ;;
  esac
}

usage_compose_target() {
  echo "usage: $1 [--rebuild] [--no-rolling] [platform|i-bff|o-bff|<compose-service> ...]" >&2
  echo "  축약어: platform / i-bff / o-bff 만. 미지정 시 docker-compose.yml 전체 서비스" >&2
  echo "  --rebuild: 이미지 리빌드(--build) 포함. 기본은 recreate only" >&2
  echo "  이중화 서비스(-1/-2)는 기본이 롤링: 한 대씩 재생성하고 healthy 확인 후 다음 대" >&2
  echo "  --no-rolling: 두 대 동시 재생성 (순단 발생, 긴급 복구용)" >&2
  echo "  lifecycle 명령은 docker-compose.yml + 존재하는 dev/prod overlay 를 병합해 실행" >&2
}

list_all_compose_services() {
  lifecycle_compose config --services
}

list_compose_services_for_files() {
  local -a compose_files=("$@")
  local -a cmd=(docker compose)
  local compose_file
  for compose_file in "${compose_files[@]}"; do
    cmd+=(-f "${compose_file}")
  done
  cmd+=(config --services)
  "${cmd[@]}"
}

build_compose_cmd() {
  local -a compose_files=("$@")
  local -a cmd=(docker compose)
  local compose_file
  for compose_file in "${compose_files[@]}"; do
    cmd+=(-f "${compose_file}")
  done
  printf '%s\n' "${cmd[@]}"
}

# base yml만으로는 image/build가 비어 있는 서비스가 있을 수 있다(overlay 패턴).
# stop/rm/logs/ps 등 lifecycle 명령은 존재하는 dev·prod overlay를 모두 병합해 config 검증을 통과시킨다.
collect_compose_overlay_files() {
  if [ -f "${DEV_COMPOSE}" ]; then
    printf '%s\n' "${DEV_COMPOSE}"
  fi
  if [ -f "${PROD_COMPOSE}" ]; then
    printf '%s\n' "${PROD_COMPOSE}"
  fi
}

compose_files_for_lifecycle() {
  printf '%s\n' "${BASE_COMPOSE}"
  collect_compose_overlay_files
}

build_lifecycle_compose_cmd() {
  local -a compose_files=()
  mapfile -t compose_files < <(compose_files_for_lifecycle)
  build_compose_cmd "${compose_files[@]}"
}

lifecycle_compose() {
  local -a compose_cmd=()
  mapfile -t compose_cmd < <(build_lifecycle_compose_cmd)
  "${compose_cmd[@]}" "$@"
}

# `up --force-recreate` 실패 시 남는 `{hash}_{name}` 컨테이너를 제거한다.
prune_stale_recreate_containers() {
  local name
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    docker rm -f "${name}" >/dev/null 2>&1 || true
  done < <(docker ps -a --format '{{.Names}}' | grep -E '^[0-9a-f]{8,}_' || true)
}

compose_stop_services() {
  local -a services=("$@")
  if [ "${#services[@]}" -eq 0 ]; then
    lifecycle_compose stop
    return 0
  fi
  lifecycle_compose stop "${services[@]}"
}

compose_rm_services() {
  local -a services=("$@")
  prune_stale_recreate_containers
  if [ "${#services[@]}" -eq 0 ]; then
    lifecycle_compose rm -f >/dev/null 2>&1 || true
    return 0
  fi
  lifecycle_compose rm -f "${services[@]}" >/dev/null 2>&1 || true
}

compose_down_services() {
  local -a services=("$@")
  compose_stop_services "${services[@]}"
  compose_rm_services "${services[@]}"
}

detect_service_compose_mode() {
  local service="${1:-}"
  local container_id config_files
  local -a compose_cmd=()

  mapfile -t compose_cmd < <(build_lifecycle_compose_cmd)
  container_id="$("${compose_cmd[@]}" ps -q "${service}" 2>/dev/null | head -n1 || true)"
  if [ -z "${container_id}" ] && docker inspect "${service}" >/dev/null 2>&1; then
    container_id="${service}"
  fi
  if [ -z "${container_id}" ]; then
    echo unknown
    return 0
  fi

  config_files="$(docker inspect "${container_id}" --format '{{index .Config.Labels "com.docker.compose.project.config_files"}}' 2>/dev/null || true)"
  case "${config_files}" in
    *docker-compose.prod.yml*) echo prod ;;
    *docker-compose.dev.yml*) echo dev ;;
    *) echo unknown ;;
  esac
}

# docker compose up 공통 플래그.
# 기본: recreate (+ orphan 정리). HIHING_COMPOSE_REBUILD=1 이면 --build 추가.
compose_up_default_args() {
  local -a args=(-d --force-recreate --remove-orphans)
  if [ "${HIHING_COMPOSE_REBUILD:-0}" = "1" ]; then
    args=(-d --build --force-recreate --remove-orphans)
  fi
  # 롤링 중에는 의존 서비스까지 --force-recreate 되지 않도록 막는다.
  # `<base>-2` 는 `<base>-1` 에 depends_on 이 걸려 있어, --no-deps 없이 2번을
  # 재생성하면 방금 띄운 1번까지 같이 내려간다.
  if [ "${HIHING_COMPOSE_NO_DEPS:-0}" = "1" ]; then
    args+=(--no-deps)
  fi
  printf '%s\n' "${args[@]}"
}

compose_up_services() {
  local mode="${1:-}"
  shift || true
  local -a targets=("$@")
  local -a compose_files=()
  local -a compose_cmd=()
  local -a up_args=()
  local -a services=()
  local runtime_override=""

  mapfile -t compose_files < <(compose_files_for_mode "${mode}")
  runtime_override=""
  if [ "${#compose_files[@]}" -gt 0 ]; then
    runtime_override="${compose_files[-1]}"
  fi
  trap 'cleanup_runtime_compose_override "${runtime_override:-}"' RETURN
  ensure_node22_ffmpeg_image "${compose_files[@]}"

  mapfile -t compose_cmd < <(build_compose_cmd "${compose_files[@]}")
  mapfile -t up_args < <(compose_up_default_args)
  prune_stale_recreate_containers

  if [ "${#targets[@]}" -eq 0 ]; then
    "${compose_cmd[@]}" up "${up_args[@]}"
    return 0
  fi

  mapfile -t services < <(resolve_services "${targets[@]}")
  "${compose_cmd[@]}" up "${up_args[@]}" "${services[@]}"
}

recreate_base_services() {
  local -a services=("$@")
  local -a compose_cmd=()
  local -a up_args=()
  prune_stale_recreate_containers
  mapfile -t compose_cmd < <(build_lifecycle_compose_cmd)
  mapfile -t up_args < <(compose_up_default_args)
  "${compose_cmd[@]}" up "${up_args[@]}" "${services[@]}"
}

# ---------------------------------------------------------------------------
# 무중단 롤링 재기동
# ---------------------------------------------------------------------------
# platform / i-bff / o-bff 는 `-1` `-2` 로 이중화되어 nginx upstream 이
# max_fails=1 fail_timeout=10s 로 한 대 장애를 흡수한다. 그러나 두 대를 한 번의
# `compose up` 으로 넘기면 동시에 내려가 순단이 난다. prod 오버레이는 `-1` 에서만
# `npm run build` 를 돌리고 `-2` 는 dist/main.js 를 기다리는데, nest 빌드가
# deleteOutDir 로 dist 를 먼저 지우므로 동시 재생성 시 `-2` 가 낡은 dist 로 뜨거나
# 빌드 중간 상태를 물 수 있다.
#
# 그래서 짝을 이루는 서비스는 한 대씩 재생성하고 healthy 를 확인한 뒤 다음으로
# 넘어간다. 첫 대가 살아나지 못하면 두 번째는 건드리지 않아 최소 한 대는
# 구버전으로 계속 서비스한다.
#
# 더 중요한 함정은 depends_on 이다. `-2` 에 `depends_on: -1` 이 걸려 있어서
# `up --force-recreate hihing-i-bff-2` 처럼 한 대만 지정해도 compose 가 `-1` 까지
# 함께 recreate 한다(--dry-run 으로 확인). 그래서 짝을 이루는 서비스는 한 대만
# 교체할 때도 --no-deps 를 붙인다. 이게 없으면 롤링 자체가 성립하지 않는다.

ROLLING_POLL_INTERVAL=3

resolve_container_ref() {
  local service="${1:-}"
  local container_id=""
  local -a compose_cmd=()

  # 이 프로젝트는 container_name 을 서비스명과 동일하게 두므로 대부분 여기서 끝난다.
  if docker inspect "${service}" >/dev/null 2>&1; then
    printf '%s\n' "${service}"
    return 0
  fi

  mapfile -t compose_cmd < <(build_lifecycle_compose_cmd)
  container_id="$("${compose_cmd[@]}" ps -q "${service}" 2>/dev/null | head -n1 || true)"
  printf '%s\n' "${container_id}"
}

container_readiness_state() {
  local container_ref="${1:-}"
  if [ -z "${container_ref}" ]; then
    printf '%s\n' missing
    return 0
  fi
  docker inspect --format \
    '{{if .State.Health}}{{.State.Health.Status}}{{else if .State.Running}}running-nohealthcheck{{else}}stopped{{end}}' \
    "${container_ref}" 2>/dev/null || printf '%s\n' missing
}

# healthcheck 가 정의된 서비스는 healthy 까지, 없으면 running 까지 기다린다.
wait_for_service_ready() {
  local service="${1:-}"
  local timeout="${2:-${HIHING_ROLLING_TIMEOUT:-300}}"
  local waited=0
  local state=""
  local container_ref=""

  while [ "${waited}" -lt "${timeout}" ]; do
    if [ -z "${container_ref}" ]; then
      container_ref="$(resolve_container_ref "${service}")"
    fi
    state="$(container_readiness_state "${container_ref}")"
    case "${state}" in
      healthy|running-nohealthcheck)
        echo "  ${service}: ${state} (${waited}s)" >&2
        return 0
        ;;
    esac
    sleep "${ROLLING_POLL_INTERVAL}"
    waited=$((waited + ROLLING_POLL_INTERVAL))
    if [ "$((waited % 30))" -eq 0 ]; then
      echo "  ${service}: ${state} — 대기 중 (${waited}s/${timeout}s)" >&2
    fi
  done

  echo "  ${service}: ${state} — ${timeout}s 안에 준비되지 않았습니다." >&2
  return 1
}

declare -a ALL_COMPOSE_SERVICES=()

# compose 정의에 `<base>-1` 과 `<base>-2` 가 모두 있으면 짝으로 본다.
# 요청 목록이 아니라 compose 정의 기준이라, 한쪽만 지정해도 짝인지 판별된다.
is_paired_service() {
  local service="${1:-}"
  local base index partner

  [[ "${service}" =~ ^(.+)-([12])$ ]] || return 1
  base="${BASH_REMATCH[1]}"
  index="${BASH_REMATCH[2]}"
  if [ "${index}" = "1" ]; then partner="${base}-2"; else partner="${base}-1"; fi

  if [ "${#ALL_COMPOSE_SERVICES[@]}" -eq 0 ]; then
    mapfile -t ALL_COMPOSE_SERVICES < <(list_all_compose_services)
  fi

  local candidate
  for candidate in "${ALL_COMPOSE_SERVICES[@]}"; do
    if [ "${candidate}" = "${partner}" ]; then
      return 0
    fi
  done
  return 1
}

# 요청 목록에 `<base>-1` 과 `<base>-2` 가 모두 있으면 순차 롤링한다.
# 한쪽만 지정한 경우(예: 특정 인스턴스만 교체)는 순서를 지킬 것이 없으므로 바로
# 재생성하되, depends_on 때문에 짝까지 끌려 들어가지 않도록 --no-deps 는 붙인다.
compose_up_services_rolling() {
  local mode="${1:-}"
  shift || true
  local -a targets=("$@")
  local -a services=()
  local -A requested=()
  local -a rolling_bases=()
  local -a paired_singles=()
  local -a singles=()
  local service base index partner member
  local rolling_status=0

  if [ "${#targets[@]}" -eq 0 ]; then
    compose_up_services "${mode}"
    return 0
  fi

  if [ "${HIHING_COMPOSE_NO_ROLLING:-0}" = "1" ]; then
    compose_up_services "${mode}" "${targets[@]}"
    return 0
  fi

  # `i-bff` 같은 축약어를 먼저 펼쳐야 짝(-1/-2)을 판별할 수 있다.
  mapfile -t services < <(resolve_services "${targets[@]}")

  for service in "${services[@]}"; do
    requested["${service}"]=1
  done

  for service in "${services[@]}"; do
    if [[ "${service}" =~ ^(.+)-([12])$ ]]; then
      base="${BASH_REMATCH[1]}"
      index="${BASH_REMATCH[2]}"
      if [ "${index}" = "1" ]; then partner="${base}-2"; else partner="${base}-1"; fi
      if [ -n "${requested[${partner}]+x}" ]; then
        if [ "${index}" = "1" ]; then
          rolling_bases+=("${base}")
        fi
        continue
      fi
      if is_paired_service "${service}"; then
        paired_singles+=("${service}")
        continue
      fi
    fi
    singles+=("${service}")
  done

  if [ "${#singles[@]}" -gt 0 ]; then
    compose_up_services "${mode}" "${singles[@]}"
  fi

  export HIHING_COMPOSE_NO_DEPS=1

  for service in "${paired_singles[@]}"; do
    echo "single: ${service} 만 재생성합니다 (--no-deps, 짝은 그대로 유지)" >&2
    compose_up_services "${mode}" "${service}"
    if ! wait_for_service_ready "${service}"; then
      echo "경고: ${service} 가 정상화되지 않았습니다. docker-compose-logs ${service} 로 확인하세요." >&2
      rolling_status=1
    fi
  done

  for base in "${rolling_bases[@]}"; do
    echo "rolling: ${base}-1 → ${base}-2 (한 대씩 재생성 후 준비 확인)" >&2
    for member in "${base}-1" "${base}-2"; do
      compose_up_services "${mode}" "${member}"
      if ! wait_for_service_ready "${member}"; then
        echo "rolling 중단: ${member} 가 정상화되지 않았습니다. 이후 인스턴스는 재생성하지 않습니다." >&2
        echo "  로그 확인: docker-compose-logs ${member}" >&2
        rolling_status=1
        break 2
      fi
    done
  done
  unset HIHING_COMPOSE_NO_DEPS

  return "${rolling_status}"
}

recreate_services_with_mode_detection() {
  local -a targets=("$@")
  local -a services=()
  local -a dev_services=()
  local -a prod_services=()
  local -a base_services=()
  local service mode

  if [ "${#targets[@]}" -eq 0 ]; then
    mapfile -t services < <(list_all_compose_services)
  else
    mapfile -t services < <(resolve_services "${targets[@]}")
  fi

  if [ "${#services[@]}" -eq 0 ]; then
    echo "재생성할 서비스가 없습니다." >&2
    return 1
  fi

  for service in "${services[@]}"; do
    mode="$(detect_service_compose_mode "${service}")"
    case "${mode}" in
      dev) dev_services+=("${service}") ;;
      prod) prod_services+=("${service}") ;;
      *) base_services+=("${service}") ;;
    esac
  done

  if [ "${#dev_services[@]}" -gt 0 ]; then
    compose_up_services_rolling dev "${dev_services[@]}"
  fi
  if [ "${#prod_services[@]}" -gt 0 ]; then
    compose_up_services_rolling prod "${prod_services[@]}"
  fi
  if [ "${#base_services[@]}" -gt 0 ]; then
    echo "note: ${base_services[*]} — dev/prod 자동 감지 불가, base compose 로 재생성합니다. 최초 기동·모드 전환은 docker-compose-up dev|prod ... 를 사용하세요." >&2
    recreate_base_services "${base_services[@]}"
  fi
}

compose_files_for_mode() {
  local mode="${1:-}"
  local override=""
  local runtime_override=""
  local -a pre_runtime_files=()
  case "${mode}" in
    dev) override="${DEV_COMPOSE}" ;;
    prod) override="${PROD_COMPOSE}" ;;
    *)
      usage_compose_mode
      return 1
      ;;
  esac

  pre_runtime_files+=("${BASE_COMPOSE}")
  if [ -f "${override}" ]; then
    pre_runtime_files+=("${override}")
  fi

  printf '%s\n' "${pre_runtime_files[@]}"
  local deploy_profile
  deploy_profile="$(resolve_deploy_profile)"
  runtime_override="$(write_runtime_compose_override "${mode}" "${deploy_profile}" "${HIHING_COMPOSE_LOG_LEVEL:-}" "${pre_runtime_files[@]}")"
  printf '%s\n' "${runtime_override}"
}

cleanup_runtime_compose_override() {
  local runtime_override="${1:-}"
  if [ -n "${runtime_override}" ] && [ -f "${runtime_override}" ]; then
    rm -f "${runtime_override}"
  fi
}

write_runtime_compose_override() {
  local mode="${1:-}"
  local deploy_profile="${2:-prod}"
  local log_level="${3:-}"
  shift 3 || true
  python3 - "${COMPOSE_ROOT}" "${mode}" "${deploy_profile}" "${log_level}" "$@" <<'PY'
import json
import os
import subprocess
import sys
import tempfile

root, mode, deploy_profile, log_level = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
compose_files = sys.argv[5:]
node_env = "production" if mode == "prod" else "development"

service_dirs = {
    "hihing-i-bff-1": "hihing-i-services/bff",
    "hihing-i-bff-2": "hihing-i-services/bff",
    "hihing-o-bff-1": "hihing-o-services/bff",
    "hihing-o-bff-2": "hihing-o-services/bff",
    "hihing-platform-api-1": "hihing-platform-api",
    "hihing-platform-api-2": "hihing-platform-api",
    "tv_frontend": "hihing-i-services/tv_frontend",
    "hihing-i-admin": "hihing-i-services/hihing-i-admin",
    "square-web": "hihing-o-services/square-web",
    "square-admin": "hihing-o-services/square-admin",
    "hihing-chatbot": "hihing-o-services/hihing-chatbot",
    "market_backend": "market_backend",
    "market_admin": "market_admin",
}

def project_services() -> set[str]:
    if not compose_files:
        return set()
    cmd = ["docker", "compose"]
    for path in compose_files:
        cmd.extend(["-f", path])
    cmd.extend(["config", "--services"])
    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return set()
    return {line.strip() for line in out.splitlines() if line.strip()}

def resolve_env_files(rel_dir: str) -> list[str]:
    dot_env = os.path.join(root, rel_dir, ".env")
    hs_env = os.path.join(root, rel_dir, ".env.hs")
    files: list[str] = []
    if os.path.isfile(dot_env):
        files.append(f"./{rel_dir}/.env")
    if deploy_profile == "hs" and os.path.isfile(hs_env):
        files.append(f"./{rel_dir}/.env.hs")
    return files

configured = project_services()
if not configured:
    fd, path = tempfile.mkstemp(prefix="hihing-compose-runtime.", suffix=".yml")
    os.close(fd)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write("services: {}\n")
    print(path)
    raise SystemExit(0)

lines = ["services:"]
has_overrides = False
for service in sorted(configured):
    rel_dir = service_dirs.get(service)
    if not rel_dir:
        continue

    has_overrides = True
    lines.append(f"  {service}:")
    env_files = resolve_env_files(rel_dir)
    if env_files:
        lines.append("    env_file:")
        for path in env_files:
            lines.append(f"      - {path}")

    environment: dict[str, str] = {
        "NODE_ENV": node_env,
        "HIHING_DEPLOY_PROFILE": deploy_profile,
    }
    if log_level:
        environment["LOG_LEVEL"] = log_level

    lines.append("    environment:")
    for key, value in environment.items():
        lines.append(f"      {key}: {json.dumps(value)}")

fd, path = tempfile.mkstemp(prefix="hihing-compose-runtime.", suffix=".yml")
os.close(fd)
with open(path, "w", encoding="utf-8") as handle:
    if has_overrides:
        handle.write("\n".join(lines) + "\n")
    else:
        handle.write("services: {}\n")
print(path)
PY
}

append_service_group() {
  local target="$1"
  case "${target}" in
    platform) printf '%s\n' hihing-platform-api-1 hihing-platform-api-2 ;;
    i-bff) printf '%s\n' hihing-i-bff-1 hihing-i-bff-2 ;;
    o-bff) printf '%s\n' hihing-o-bff-1 hihing-o-bff-2 ;;
    *) printf '%s\n' "${target}" ;;
  esac
}

resolve_services() {
  if [ "$#" -eq 0 ]; then
    return 1
  fi

  local target
  local service
  local -A seen=()
  local -a resolved=()

  for target in "$@"; do
    while IFS= read -r service; do
      [ -n "${service}" ] || continue
      if [ -z "${seen[${service}]+x}" ]; then
        resolved+=("${service}")
        seen["${service}"]=1
      fi
    done < <(append_service_group "${target}")
  done

  printf '%s\n' "${resolved[@]}"
}

resolve_services_if_any() {
  if [ "$#" -eq 0 ]; then
    return 0
  fi

  resolve_services "$@"
}

compose_service_exists() {
  local service_name="${1:-}"
  shift || true
  python3 - "$service_name" "$@" <<'PY'
import subprocess
import sys

service = sys.argv[1]
files = sys.argv[2:]
cmd = ["docker", "compose"]
for path in files:
    cmd.extend(["-f", path])
cmd.extend(["config", "--services"])

try:
    out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
except subprocess.CalledProcessError:
    raise SystemExit(1)

services = {line.strip() for line in out.splitlines() if line.strip()}
raise SystemExit(0 if service in services else 1)
PY
}

ensure_node22_ffmpeg_image() {
  if [ "$#" -eq 0 ]; then
    return 0
  fi

  if ! compose_service_exists "node22-ffmpeg" "$@"; then
    return 0
  fi

  if docker image inspect node22-ffmpeg >/dev/null 2>&1; then
    return 0
  fi

  echo "node22-ffmpeg image missing; building once..." >&2
  (
    cd "${COMPOSE_ROOT}"
    local cmd=(docker compose)
    local compose_file
    for compose_file in "$@"; do
      cmd+=(-f "${compose_file}")
    done
    cmd+=(build node22-ffmpeg)
    "${cmd[@]}"
  )
}
