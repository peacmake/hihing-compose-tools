#!/usr/bin/env bash
# hs-sync: HS(스테이징) 저장소를 GitHub(origin) 기준으로 fast-forward 만 한다.
#
# 개발은 맥북에서 하고 GitHub 에 push 한 뒤, HS 에서는 이 스크립트로 받아온 다음
# 기존 dp-* / docker-compose-up 으로 배포한다.
#
#   hs-sync all                    # 전체 저장소
#   hs-sync platform i-services    # 일부만 (별칭 또는 디렉터리 이름)
#   hs-sync --dry-run all          # fetch 후 상태만 보여 주고 merge 하지 않음
#   hs-sync --no-master platform   # 현재 브랜치만, 로컬 master 갱신 생략
#
# 안전 규칙
#   - git fetch origin 후 git merge --ff-only origin/<현재 브랜치> 만 한다.
#   - 추적 파일에 미커밋 변경이 있거나, 서버에만 있는 커밋이 있어
#     fast-forward 가 안 되면 거부하고 이유를 출력한다.
#   - reset / stash / checkout / clean 은 절대 하지 않는다.
#   - dp-* 는 "로컬 master" 를 체크아웃해 빌드하므로, 현재 브랜치가 master 가
#     아니면 로컬 master 도 `git fetch origin master:master`(ff 만 허용) 로 갱신한다.
set -uo pipefail

HS_ROOT="${HS_ROOT:-/home/hsmaster}"

# 별칭|디렉터리
REPOS=(
  "platform|hihing-platform-api"
  "i-services|hihing-i-services"
  "o-services|hihing-o-services"
  "docs|0_new_architecture_work"
  "compose-tools|hihing-compose-tools"
  "tv_backend|tv_backend"
  "market_backend|market_backend"
  "market_admin|market_admin"
  "web|www"
)

dry_run=0
sync_master=1
targets=()

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

for a in "$@"; do
  case "$a" in
    -n|--dry-run) dry_run=1 ;;
    --no-master) sync_master=0 ;;
    -h|--help) usage; exit 0 ;;
    *) targets+=("$a") ;;
  esac
done
[ "${#targets[@]}" -eq 0 ] && { usage; exit 2; }

resolve() {
  local t="$1" e
  for e in "${REPOS[@]}"; do
    if [ "$t" = "${e%%|*}" ] || [ "$t" = "${e#*|}" ]; then
      echo "${HS_ROOT}/${e#*|}"; return 0
    fi
  done
  return 1
}

paths=()
if [ "${targets[0]}" = "all" ]; then
  for e in "${REPOS[@]}"; do paths+=("${HS_ROOT}/${e#*|}"); done
else
  for t in "${targets[@]}"; do
    p="$(resolve "$t")" || { echo "알 수 없는 저장소: $t" >&2; exit 2; }
    paths+=("$p")
  done
fi

ok=0; fail=0; failed=()

refuse() { echo "  ✗ 거부: $*" >&2; fail=$((fail+1)); failed+=("$(basename "$repo")"); }

for repo in "${paths[@]}"; do
  echo "== $(basename "$repo")"
  if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    refuse "git 저장소가 아닙니다: $repo"; continue
  fi
  if [ ! -w "$(git -C "$repo" rev-parse --absolute-git-dir)" ]; then
    refuse "쓰기 권한이 없습니다 ($(stat -c %U "$repo" 2>/dev/null) 소유). 해당 계정으로 실행하세요."; continue
  fi
  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD)" || {
    refuse "detached HEAD 입니다. 브랜치를 체크아웃한 뒤 다시 실행하세요."; continue; }

  if ! git -C "$repo" fetch --prune origin; then
    refuse "git fetch origin 실패 (네트워크/인증 확인)"; continue
  fi
  if ! git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/${branch}" >/dev/null; then
    refuse "origin/${branch} 가 없습니다. 맥북에서 먼저 push 하세요."; continue
  fi

  dirty="$(git -C "$repo" status --porcelain --untracked-files=no)"
  if [ -n "$dirty" ]; then
    refuse "추적 파일에 미커밋 변경이 있습니다. 서버에서 직접 고친 내용은 맥북으로 옮겨 커밋·push 한 뒤 정리하세요.
$(echo "$dirty" | sed 's/^/      /' | head -20)"
    continue
  fi

  ahead="$(git -C "$repo" rev-list --count "origin/${branch}..${branch}")"
  behind="$(git -C "$repo" rev-list --count "${branch}..origin/${branch}")"
  if [ "$ahead" -gt 0 ]; then
    refuse "${branch} 에 origin 에 없는 서버 전용 커밋 ${ahead}개가 있어 fast-forward 할 수 없습니다.
      확인: git -C $repo log --oneline origin/${branch}..${branch}
      서버 커밋을 GitHub 에 올리거나(맥북에서 반영) 정리한 뒤 다시 실행하세요."
    continue
  fi

  if [ "$behind" -eq 0 ]; then
    echo "  = ${branch} 최신 ($(git -C "$repo" rev-parse --short HEAD))"
  elif [ "$dry_run" = 1 ]; then
    echo "  (dry-run) ${branch}: ${behind}개 커밋 받을 예정"
    git -C "$repo" log --oneline "${branch}..origin/${branch}" | head -10 | sed 's/^/      /'
  else
    before="$(git -C "$repo" rev-parse --short HEAD)"
    if ! git -C "$repo" merge --ff-only "origin/${branch}"; then
      refuse "fast-forward merge 실패 (미추적 파일이 덮어써질 수 있음 등). 위 git 메시지를 확인하세요."; continue
    fi
    echo "  ✓ ${branch}: ${before} → $(git -C "$repo" rev-parse --short HEAD) (${behind}개)"
  fi

  # dp-* 는 로컬 master 를 체크아웃해 빌드한다. 현재 브랜치가 master 가 아니면 master 도 ff 갱신.
  if [ "$sync_master" = 1 ] && [ "$branch" != "master" ] \
     && git -C "$repo" show-ref --verify --quiet refs/heads/master \
     && git -C "$repo" rev-parse --verify --quiet refs/remotes/origin/master >/dev/null; then
    m_ahead="$(git -C "$repo" rev-list --count origin/master..master)"
    m_behind="$(git -C "$repo" rev-list --count master..origin/master)"
    if [ "$m_ahead" -gt 0 ]; then
      refuse "로컬 master 에 서버 전용 커밋 ${m_ahead}개가 있어 master 는 갱신하지 않았습니다."; continue
    elif [ "$m_behind" -gt 0 ]; then
      if [ "$dry_run" = 1 ]; then
        echo "  (dry-run) 로컬 master: ${m_behind}개 커밋 받을 예정"
      elif git -C "$repo" fetch origin master:master; then
        echo "  ✓ 로컬 master 도 origin/master 로 fast-forward (${m_behind}개)"
      else
        refuse "로컬 master fast-forward 실패"; continue
      fi
    fi
  fi
  ok=$((ok+1))
done

echo
echo "완료: 성공 ${ok}, 거부 ${fail}${failed:+ (${failed[*]})}"
[ "$fail" -eq 0 ] && echo "다음: dp-* 또는 docker-compose-up 으로 배포하세요."
[ "$fail" -eq 0 ]
